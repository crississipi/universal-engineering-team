{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crississipi.github.io/universal-engineering-team/schemas/executions/closure.schema.json",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "closure": {
          "type": "object",
          "properties": {
            "closure_id": {
              "$ref": "./definitions/identifiers.schema.json#/$defs/clsId"
            },
            "execution_id": {
              "$ref": "./definitions/identifiers.schema.json#/$defs/exeId"
            },
            "completion": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "incomplete",
                    "complete",
                    "complete_with_exceptions"
                  ]
                },
                "summary": {
                  "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                },
                "completed_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "cancelled_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "outstanding_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "completion_evidence_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
                  },
                  "minItems": 0
                }
              },
              "required": [
                "status",
                "summary",
                "completed_work_item_ids",
                "cancelled_work_item_ids",
                "outstanding_work_item_ids"
              ],
              "additionalProperties": false
            },
            "verification": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_started",
                    "in_progress",
                    "passed",
                    "passed_with_exceptions",
                    "failed"
                  ]
                },
                "summary": {
                  "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                },
                "verification_scope": {
                  "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                },
                "verified_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "failed_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "not_verified_work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
                  },
                  "minItems": 0
                }
              },
              "required": [
                "status",
                "summary",
                "verification_scope",
                "verified_work_item_ids",
                "failed_work_item_ids",
                "not_verified_work_item_ids",
                "evidence_refs"
              ],
              "additionalProperties": false
            },
            "closure_status": {
              "type": "string",
              "enum": [
                "not_started",
                "in_preparation",
                "in_review",
                "blocked",
                "closed",
                "cancelled"
              ]
            },
            "closure_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "check_id": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "scope_accounting",
                      "role_activation_completion",
                      "work_item_completion",
                      "dependency_resolution",
                      "handoff_resolution",
                      "decision_resolution",
                      "evidence_completeness",
                      "verification_completion",
                      "blocker_resolution",
                      "replanning_completion",
                      "release_readiness",
                      "release_completion",
                      "documentation_completion",
                      "security_requirements",
                      "quality_requirements",
                      "operational_readiness",
                      "accessibility_requirements",
                      "delivery_requirements",
                      "other"
                    ]
                  },
                  "description": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "not_applicable",
                      "not_verified"
                    ]
                  },
                  "related_record_refs": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "evidence_refs": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "notes": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "checked_by_role": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
                  },
                  "checked_at": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
                  }
                },
                "required": [
                  "check_id",
                  "category",
                  "description",
                  "result",
                  "related_record_refs",
                  "evidence_refs",
                  "notes"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exception_id": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "scope_deviation",
                      "incomplete_work",
                      "verification_gap",
                      "verification_failure",
                      "dependency_exception",
                      "handoff_exception",
                      "blocker_exception",
                      "documentation_gap",
                      "security_risk",
                      "quality_risk",
                      "operational_risk",
                      "release_exception",
                      "external_constraint",
                      "other"
                    ]
                  },
                  "description": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "reason": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "impact_summary": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "residual_risk": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "affected_record_refs": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "evidence_refs": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "accepted_by_decision_id": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/decId"
                  },
                  "responsible_role": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
                  },
                  "follow_up_references": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected",
                      "withdrawn"
                    ]
                  }
                },
                "required": [
                  "exception_id",
                  "category",
                  "description",
                  "reason",
                  "impact_summary",
                  "residual_risk",
                  "affected_record_refs",
                  "evidence_refs",
                  "accepted_by_decision_id",
                  "follow_up_references",
                  "status"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "required_record_refs": {
              "type": "object",
              "properties": {
                "role_activation_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/actId"
                  },
                  "minItems": 0
                },
                "work_item_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                  },
                  "minItems": 0
                },
                "dependency_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/depId"
                  },
                  "minItems": 0
                },
                "handoff_execution_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/hexId"
                  },
                  "minItems": 0
                },
                "decision_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/decId"
                  },
                  "minItems": 0
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
                  },
                  "minItems": 0
                },
                "blocker_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/blkId"
                  },
                  "minItems": 0
                },
                "replan_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "./definitions/identifiers.schema.json#/$defs/rplId"
                  },
                  "minItems": 0
                },
                "release_record_refs": {
                  "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                }
              },
              "required": [
                "role_activation_ids",
                "work_item_ids",
                "dependency_ids",
                "handoff_execution_ids",
                "decision_ids",
                "evidence_ids",
                "blocker_ids",
                "replan_ids",
                "release_record_refs"
              ],
              "additionalProperties": false
            },
            "closure_decision_id": {
              "$ref": "./definitions/identifiers.schema.json#/$defs/decId"
            },
            "proposed_by_role": {
              "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
            },
            "coordinated_by_role": {
              "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
            },
            "closure_authorized_by_role": {
              "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
            },
            "closure_summary": {
              "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
            },
            "residual_risks": {
              "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
            },
            "follow_up_references": {
              "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
            },
            "created_at": {
              "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
            },
            "updated_at": {
              "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
            },
            "proposed_at": {
              "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
            },
            "reviewed_at": {
              "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
            },
            "closed_at": {
              "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event_id": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "event_type": {
                    "type": "string",
                    "enum": [
                      "closure_record_created",
                      "completion_assessed",
                      "verification_assessed",
                      "closure_check_added",
                      "closure_check_updated",
                      "exception_proposed",
                      "exception_approved",
                      "exception_rejected",
                      "exception_withdrawn",
                      "closure_review_started",
                      "closure_review_completed",
                      "closure_blocked",
                      "closure_unblocked",
                      "closure_decision_recorded",
                      "closure_status_changed",
                      "closure_cancelled",
                      "closure_approved",
                      "closure_summary_updated",
                      "follow_up_reference_added",
                      "record_corrected"
                    ]
                  },
                  "previous_value": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "new_value": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "reason": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                  },
                  "actor_role": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
                  },
                  "related_record_refs": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                  },
                  "occurred_at": {
                    "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
                  }
                },
                "required": [
                  "event_id",
                  "event_type",
                  "reason",
                  "actor_role",
                  "related_record_refs",
                  "occurred_at"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "closure_id",
            "execution_id",
            "completion",
            "verification",
            "closure_status",
            "closure_checks",
            "exceptions",
            "required_record_refs",
            "closure_summary",
            "residual_risks",
            "follow_up_references",
            "created_at",
            "updated_at",
            "history"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "closure_status": {
                    "const": "closed"
                  }
                },
                "required": [
                  "closure_status"
                ]
              },
              "then": {
                "required": [
                  "closure_decision_id",
                  "closure_authorized_by_role",
                  "closed_at"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "closure_status": {
                    "const": "cancelled"
                  }
                },
                "required": [
                  "closure_status"
                ]
              },
              "then": {
                "required": [
                  "closure_decision_id"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "closure"
      ],
      "additionalProperties": false
    }
  }
}
