{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crississipi.github.io/universal-engineering-team/schemas/executions/evidence.schema.json",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
              },
              "execution_id": {
                "$ref": "./definitions/identifiers.schema.json#/$defs/exeId"
              },
              "evidence_type": {
                "type": "string",
                "enum": [
                  "test_result",
                  "build_result",
                  "security_result",
                  "performance_result",
                  "accessibility_result",
                  "review_record",
                  "approval_record",
                  "implementation_artifact",
                  "operational_record",
                  "documentation",
                  "external_reference",
                  "other"
                ]
              },
              "title": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "description": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "execution_artifact",
                  "repository_reference",
                  "tool_output",
                  "external_system",
                  "document",
                  "human_observation",
                  "other"
                ]
              },
              "source_ref": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "produced_by_role": {
                "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
              },
              "verified_by_role": {
                "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
              },
              "verification_status": {
                "type": "string",
                "enum": [
                  "unverified",
                  "verified",
                  "invalid",
                  "superseded"
                ]
              },
              "verification_notes": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "related_record_refs": {
                "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
              },
              "captured_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "created_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "updated_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "supersedes_evidence_id": {
                "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "changed_at": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
                    },
                    "changed_by_role": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
                    },
                    "change_type": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                    },
                    "reason": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                    },
                    "previous_status": {
                      "type": "string",
                      "enum": [
                        "unverified",
                        "verified",
                        "invalid",
                        "superseded"
                      ]
                    },
                    "new_status": {
                      "type": "string",
                      "enum": [
                        "unverified",
                        "verified",
                        "invalid",
                        "superseded"
                      ]
                    },
                    "changed_fields": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                    }
                  },
                  "required": [
                    "changed_at",
                    "changed_by_role",
                    "change_type",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "evidence_id",
              "execution_id",
              "evidence_type",
              "title",
              "description",
              "source_type",
              "source_ref",
              "verification_status",
              "captured_at",
              "created_at",
              "updated_at",
              "history"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verification_status": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "verification_status"
                  ]
                },
                "then": {
                  "required": [
                    "verified_by_role"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "verification_status": {
                      "enum": [
                        "invalid",
                        "superseded"
                      ]
                    }
                  },
                  "required": [
                    "verification_status"
                  ]
                },
                "then": {
                  "required": [
                    "verification_notes"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "verification_status": {
                      "const": "superseded"
                    }
                  },
                  "required": [
                    "verification_status"
                  ]
                },
                "then": {
                  "required": [
                    "supersedes_evidence_id"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
