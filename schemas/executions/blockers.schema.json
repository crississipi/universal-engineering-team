{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crississipi.github.io/universal-engineering-team/schemas/executions/blockers.schema.json",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "blocker_id": {
                "$ref": "./definitions/identifiers.schema.json#/$defs/blkId"
              },
              "execution_id": {
                "$ref": "./definitions/identifiers.schema.json#/$defs/exeId"
              },
              "title": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "description": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "blocker_type": {
                "type": "string",
                "enum": [
                  "missing_input",
                  "dependency",
                  "handoff",
                  "technical",
                  "environment",
                  "security",
                  "external",
                  "resource",
                  "approval",
                  "scope",
                  "other"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "blocked",
                  "resolved",
                  "deferred",
                  "cancelled"
                ]
              },
              "reported_by_role": {
                "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
              },
              "responsible_role": {
                "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
              },
              "affected_work_item_ids": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/wiId"
                },
                "minItems": 1
              },
              "affected_dependency_ids": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/depId"
                },
                "minItems": 0
              },
              "related_handoff_execution_ids": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/hexId"
                },
                "minItems": 0
              },
              "related_decision_ids": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/decId"
                },
                "minItems": 0
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
                },
                "minItems": 0
              },
              "resolution_summary": {
                "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
              },
              "resolution_evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "./definitions/identifiers.schema.json#/$defs/evdId"
                },
                "minItems": 0
              },
              "created_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "updated_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "resolved_at": {
                "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "changed_at": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/timestamp"
                    },
                    "changed_by_role": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/roleId"
                    },
                    "change_type": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                    },
                    "reason": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/nonEmptyString"
                    },
                    "previous_status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "in_progress",
                        "blocked",
                        "resolved",
                        "deferred",
                        "cancelled"
                      ]
                    },
                    "new_status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "in_progress",
                        "blocked",
                        "resolved",
                        "deferred",
                        "cancelled"
                      ]
                    },
                    "changed_fields": {
                      "$ref": "./definitions/common-values.schema.json#/$defs/stringArray"
                    }
                  },
                  "required": [
                    "changed_at",
                    "changed_by_role",
                    "change_type",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "blocker_id",
              "execution_id",
              "title",
              "description",
              "blocker_type",
              "severity",
              "status",
              "reported_by_role",
              "responsible_role",
              "affected_work_item_ids",
              "created_at",
              "updated_at",
              "history"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "resolution_summary",
                    "resolution_evidence_refs",
                    "resolved_at"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "blockers"
      ],
      "additionalProperties": false
    }
  }
}
