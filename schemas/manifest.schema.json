{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Engineering Team Manifest",
  "description": "Derived collaboration index. Canonical source documents are listed in sources and remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources",
    "roles",
    "artifacts",
    "relationships",
    "handoffs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "artifacts",
        "handoffs",
        "relationships",
        "handoff_contract",
        "handoff_acceptance",
        "handoff_escalation",
        "workflow_lifecycle",
        "execution_records"
      ],
      "properties": {
        "roles": {
          "const": "docs/team/expected-roles.yml"
        },
        "artifacts": {
          "const": "docs/team/ownership.yml"
        },
        "handoffs": {
          "const": "docs/team/ownership.yml"
        },
        "relationships": {
          "const": "docs/team/producer-consumer-matrix.md"
        },
        "handoff_contract": {
          "const": "docs/team/handoff-contract-schema.md"
        },
        "handoff_acceptance": {
          "const": "docs/team/handoff-acceptance-rules.md"
        },
        "handoff_escalation": {
          "const": "docs/team/handoff-escalation-rules.md"
        },
        "workflow_lifecycle": {
          "const": "docs/team/workflow-lifecycle.md"
        },
        "execution_records": {
          "const": "docs/team/execution-record-model.md"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "skill": {
            "type": "string",
            "pattern": "^skills/[a-z][a-z0-9-]*/SKILL\\.md$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "primary_producer",
          "contributors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ART-[A-Z0-9-]+$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "primary_producer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "contributors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "producer_artifact_id",
          "consumer_artifact_id",
          "relationship_type",
          "output",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REL-ART-[A-Z0-9-]+--ART-[A-Z0-9-]+$"
          },
          "producer_artifact_id": {
            "type": "string",
            "pattern": "^ART-[A-Z0-9-]+$"
          },
          "consumer_artifact_id": {
            "type": "string",
            "pattern": "^ART-[A-Z0-9-]+$"
          },
          "relationship_type": {
            "enum": [
              "required_input",
              "conditional_input",
              "feedback"
            ]
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contract_version",
          "from_role",
          "to_role",
          "artifact_id",
          "consumer_artifact_id",
          "relationship_type",
          "purpose",
          "required_outputs",
          "required_context",
          "acceptance_checks",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HOF-[A-Z0-9-]+$"
          },
          "contract_version": {
            "type": "string",
            "minLength": 1
          },
          "from_role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "to_role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^ART-[A-Z0-9-]+$"
          },
          "consumer_artifact_id": {
            "type": "string",
            "pattern": "^ART-[A-Z0-9-]+$"
          },
          "relationship_type": {
            "enum": [
              "required_input",
              "conditional_input",
              "feedback"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "activation_condition": {
            "type": "string",
            "minLength": 1
          },
          "required_outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "proposed",
              "active",
              "deprecated"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "relationship_type": {
                  "const": "conditional_input"
                }
              },
              "required": [
                "relationship_type"
              ]
            },
            "then": {
              "required": [
                "activation_condition"
              ]
            }
          }
        ]
      }
    }
  }
}
